# Immutable cache for Vite hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Ensure index.html is revalidated so deployments update immediately
/index.html
  Cache-Control: public, max-age=0, must-revalidate
