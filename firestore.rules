rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products, Categories, Delivery Zones, Coupons, Settings, Reviews: Public Read and Write
    match /products/{productId} {
      allow read, write: if true;
    }
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /deletedProducts/{productId} {
      allow read, write: if true;
    }
    match /deletedCategories/{categoryId} {
      allow read, write: if true;
    }
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }
    match /deletedSuppliers/{supplierId} {
      allow read, write: if true;
    }
    match /sourcingLocations/{locId} {
      allow read, write: if true;
    }
    match /deletedSourcingLocations/{locId} {
      allow read, write: if true;
    }
    match /deliveryZones/{zoneId} {
      allow read, write: if true;
    }
    match /coupons/{couponId} {
      allow read, write: if true;
    }
    match /websiteSettings/{settingId} {
      allow read, write: if true;
    }
    match /system_settings/{settingId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /system/{docId} {
      allow read, write: if true;
    }
    match /heroBannerVideos/{videoId} {
      allow read, write: if true;
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }
    match /productImageMedia/{mediaId} {
      allow read, write: if true;
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
    match /preview_reviews/{reviewId} {
      allow read, write: if true;
    }
    match /deletedReviews/{reviewId} {
      allow read, write: if true;
    }
    match /preview_deletedReviews/{reviewId} {
      allow read, write: if true;
    }
    // Orders: Anyone can create an order, read by id or query, admin can manage/delete
    match /orders/{orderId} {
      allow read, write: if true;
    }
    // Staff, Roles, Permissions, Activity Logs, Notifications, Inventory
    match /staff/{staffId} {
      allow read, write: if true;
    }
    match /roles/{roleId} {
      allow read, write: if true;
    }
    match /permissions/{permissionId} {
      allow read, write: if true;
    }
    match /activityLogs/{logId} {
      allow read, write: if true;
    }
    match /inventory/{inventoryId} {
      allow read, write: if true;
    }
    match /inventoryLogs/{logId} {
      allow read, write: if true;
    }
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    match /customers/{customerId} {
      allow read, write: if true;
    }
    match /deletedCustomers/{customerId} {
      allow read, write: if true;
    }
    match /deletedStaff/{staffId} {
      allow read, write: if true;
    }
    // Cart Activities & Wishlist & Live tracking & Newsletter Subscribers
    match /cartActivities/{activityId} {
      allow read, write: if true;
    }
    match /wishlistActivities/{activityId} {
      allow read, write: if true;
    }
    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if true;
    }
    // Users & Profiles
    match /users/{userId} {
      allow read, write: if true;
    }
    // Email logs, SMS logs, Activity logs, Google sheets sync, Expenses, Other profits
    match /emailLogs/{logId} {
      allow read, write: if true;
    }
    match /sms_logs/{logId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    match /other_profits/{profitId} {
      allow read, write: if true;
    }
    match /googleSheetsSync/{syncId} {
      allow read, write: if true;
    }
    match /whatsapp_messages/{messageId} {
      allow read, write: if true;
    }
    match /whatsapp_webhooks/{webhookId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
    // Universal catch-all rule to prevent unhandled collection snapshot permission denial
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

