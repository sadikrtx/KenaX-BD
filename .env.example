# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMAIL & SMTP CONFIGURATION: Optional for live email dispatch.
# Use your Google Account Email and a 16-character Google App Password.
GMAIL_USER="sadikrtx3060@gmail.com"
GMAIL_APP_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
ADMIN_NOTIFICATION_EMAIL="sadikrtx3060@gmail.com"

# META WHATSAPP CLOUD API WEBHOOK & MESSAGING
# Verify token entered in Meta Developer Dashboard > WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN="kenax_whatsapp_webhook_2026"
# Meta App Secret from App Settings > Basic (for X-Hub-Signature-256 HMAC verification)
WHATSAPP_APP_SECRET=""
# Permanent System User Access Token or Temporary Developer Token from Meta Dashboard
WHATSAPP_ACCESS_TOKEN=""
# Phone Number ID assigned by Meta WhatsApp Cloud API (e.g. 104829384920192)
WHATSAPP_PHONE_NUMBER_ID=""
# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# STEADFAST COURIER API (FOR LIVE FRAUD & DELIVERY SUCCESS CHECKING)
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
